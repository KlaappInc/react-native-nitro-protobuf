{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitroprotobuf"
  ],
  "ios": {
    "iosModuleName": "NitroProtobuf"
  },
  "android": {
    "androidNamespace": [
      "nitroprotobuf"
    ],
    "androidCxxLibName": "NitroProtobuf"
  },
  "autolinking": {
    "Protobuf": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridProtobuf"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
